# ============================================================
# DRINK QUICK BACKEND — ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in real values.
# NEVER commit .env (the real one) to GitHub.
# ============================================================

# Supabase PostgreSQL connection string (required)
# Render -> backend service -> Environment -> DATABASE_URL
DATABASE_URL=postgresql://postgres.your-ref:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Server port (Render sets automatically)
PORT=10000

# Admin password protecting /api/admin/* routes (REQUIRED — the backend warns loudly
# if this is missing and falls back to the insecure default "admin123")
ADMIN_PASSWORD=change_me

# Groq API key for the AI chat assistant (/api/ai/chat)
# If unset, the AI assistant returns "AI service not configured"
GROQ_API_KEY=your_groq_key_here

# SendGrid API key for verification/welcome emails (required for email to work)
SENDGRID_API_KEY=SG.your_sendgrid_key_here

# From/sender email (optional; falls back to m.derick@africet.org)
EMAIL_FROM=noreply@drinkquick.app

# ============================================================
# NOTCH PAY (unified Mobile Money + card — one API)
# Keys from business.notchpay.co → Settings → API Keys.
# ============================================================
# Public key (pk_...) sent in the Authorization header.
NOTCHPAY_PUBLIC_KEY=pk_live_your_key
# Private key (sk_...) sent in the X-Grant header (sensitive ops only).
NOTCHPAY_PRIVATE_KEY=sk_live_your_key
# Webhook "Hash Key" from the dashboard (HMAC-SHA256 secret).
NOTCHPAY_WEBHOOK_SECRET=your_webhook_hash
# Optional override (defaults to https://api.notchpay.co)
# NOTCHPAY_BASE_URL=https://api.notchpay.co