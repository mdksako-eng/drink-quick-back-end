# ============================================================
# DRINK QUICK BACKEND — ENVIRONMENT TEMPLATE
# Copy this file to .env and fill in real values.
# NEVER commit .env (the real one) to GitHub.
# ============================================================

# Supabase PostgreSQL connection string (required)
# Render -> backend service -> Environment -> DATABASE_URL
DATABASE_URL=postgresql://postgres.your-ref:YOUR_DB_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

# Server port (Render sets automatically)
PORT=10000

# ============================================================
# SERVER-PRICED PAYMENTS (optional, recommended)
# ============================================================
# The till asks POST /api/orders/quote for the price of its cart; the server
# signs that price and /payment/* refuses any other amount. This is what stops a
# buggy or modified app from collecting less than the sale is worth.
#
# 1) Set a random secret (16+ characters) to ENABLE signing. Without it the
#    feature stays off and payments behave exactly as before.
# 2) Ship the app version that sends `quoteToken`, verify a few sales, then set
#    PAYMENT_QUOTE_REQUIRED=true to make the token mandatory.
ORDER_QUOTE_SECRET=
PAYMENT_QUOTE_REQUIRED=false

# ============================================================
# LEGAL CONSENT (Terms of Service / Privacy Policy)
# ============================================================
# Every registration stamps two rows in `legal_acceptances` (terms + privacy) with
# the version below, the moment, and the caller's IP. Bump LEGAL_VERSION whenever
# the published legal text changes, so you can tell which text a user accepted.
# LEGAL_ACCEPTANCE_REQUIRED=true refuses a signup that sends no consent at all —
# switch it on once every device runs a build that sends `termsAccepted`.
LEGAL_VERSION=2026-11
LEGAL_ACCEPTANCE_REQUIRED=false

# ============================================================
# SECOND FACTOR (opt-in email code)
# ============================================================
# Off unless set to true. While it is off, NO login is ever challenged — even an
# account with `users.two_factor_enabled = true` — and the opt-in endpoint refuses.
# Turn it on only once every till runs a build that can ask for the code.
TWO_FACTOR_ENABLED=false

# ============================================================
# PASSWORD WORK (login bursts)
# ============================================================
# Passwords use the NATIVE bcrypt, so hashing runs on libuv's threadpool instead of
# blocking the event loop. UV_THREADPOOL_SIZE is how many hashes can run at once;
# AUTH_CONCURRENCY caps the queue in front of them so a login storm cannot take every
# thread and starve payments / health checks. Keep AUTH_CONCURRENCY ≤ UV_THREADPOOL_SIZE.
UV_THREADPOOL_SIZE=8
AUTH_CONCURRENCY=8

# ============================================================
# SESSION LOOKUP CACHE
# ============================================================
# Every authenticated request would otherwise cost a database round-trip to resolve
# its token. A short cache makes the common case free. Logout, blocking a user, a
# login from another device and a manager-approved device change all delete the
# entry immediately; this TTL only bounds plain expiry. Set 0 to disable the cache.
SESSION_CACHE_TTL_MS=30000

# ============================================================
# PLATFORM ADMIN OVERRIDE  (required for the admin panel and /api/admin/*)
# ============================================================
# The admin panel sends this value as `X-Admin-Password`; the /api/admin/* routes
# accept it as a Bearer token. It must be at least 12 characters — when it is
# missing or shorter, the override is DISABLED, and there is no default (it used
# to fall back to a public one, which let anyone act as a platform Administrator).
# No other service should share this value.
# Ops check: ADMIN_PASSWORD=... npm --prefix drinks-calculator-backend run campay:readiness
ADMIN_PASSWORD=

# ============================================================
# DATABASE TLS VERIFICATION
# ============================================================
# true = verify Supabase's certificate (rejects a man-in-the-middle).
# Leave unset until you have confirmed on staging that the certificate chain is
# trusted by the Node runtime — a wrong chain stops the backend from connecting.
PGSSL_STRICT=false

# Groq API key for the AI chat assistant (/api/ai/chat)
# If unset, the AI assistant returns "AI service not configured"
GROQ_API_KEY=your_groq_key_here

# SendGrid API key for verification/welcome/support emails (required for email to work)
# Create one at https://app.sendgrid.com → Settings → API Keys. It looks like: SG.xxxxxxxx
# No domain needed: verify a single Sender address instead (Settings → Sender Authentication).
SENDGRID_API_KEY=SG.your_sendgrid_key_here

# Sender address — must be a verified Sender in SendGrid.
EMAIL_FROM=noreply@drinkquick.app
# Optional display name shown to recipients.
EMAIL_FROM_NAME=Drink Quick Cal

# ============================================================
# AUTH — PASSWORD RESET LIMITS
# How many reset emails one address may ask for per rolling 24 hours (default 3),
# and how many wrong codes it may try per 15 minutes (default 5). Counted from the
# password_reset_requests table, so a restart cannot hand out a fresh allowance.
# ============================================================
# PASSWORD_RESET_MAX_PER_DAY=3
# PASSWORD_RESET_MAX_CODE_ATTEMPTS=5

# ============================================================
# PAYMENT RAIL — CamerPay
# Notch Pay was REMOVED (2026-10-28): its keys, routes and webhook are gone.
# Subscriptions (platform account, below) and a company collecting from its own
# customers (per-company account) both go through CamerPay now.
# ============================================================
# Platform token from the CamerPay dashboard (/client/api) — subscriptions.
CAMERPAY_TOKEN=your_camerpay_token
# Webhook secret for the platform account (HMAC-SHA256 over the raw body).
CAMERPAY_WEBHOOK_SECRET=your_webhook_secret
# CamerPay cannot tell sandbox from live in the token — the ACCOUNT decides, so
# this is the operator's declaration. Set true once KYC is approved; every
# activation still requires a transaction with is_sandbox=false.
# CAMERPAY_ACCOUNT_LIVE=false
# Optional: request timeout in ms (base URL defaults to the production host).
# CAMERPAY_TIMEOUT_MS=15000

# Per-company credentials are encrypted at rest with this key (AES-256-GCM).
# Without it a company cannot connect its own CamerPay account (the app shows
# vault_key_missing). It MUST stay stable — a new key makes every stored
# credential unreadable, so each company would have to reconnect.
# PAYMENT_CREDENTIALS_KEY=<32+ random bytes, e.g. openssl rand -base64 32>

# CamerPay publishes no fee table, so the rates are ours. 'absorbed' (default)
# keeps the customer's price as listed; 'gross_up' adds the fee on top.
# CAMERPAY_FEE_MODE=absorbed
# CAMERPAY_FEE_RATES='{"orange_money":{"bps":150,"flat":0}}'
# (per-method overrides also exist: CAMERPAY_FEE_<METHOD>_BPS / _FLAT)

# Subscription activation is refused when a webhook reports LESS than the plan
# price (a leaked webhook secret must not buy a month for 1 XAF). Set this to
# true only if the provider ever reports a net, fee-deducted amount.
# PAYMENTS_ALLOW_UNDERPAYMENT=false

# Refuse to START a payment while the account cannot collect real money. Turn
# this on for the production service; leave it off while demoing. The app reads
# GET /subscriptions/campay/health, which reports the truth either way.
# PAYMENTS_REQUIRE_LIVE=false