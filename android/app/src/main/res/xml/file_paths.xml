<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- For saving to Downloads folder -->
    <external-path
        name="downloads"
        path="Download/" />
    
    <!-- For saving to Documents folder -->
    <external-path
        name="documents"
        path="Documents/" />
    
    <!-- For app's private external storage -->
    <external-files-path
        name="private_files"
        path="." />
    
    <!-- For app's private internal storage -->
    <files-path
        name="internal_files"
        path="." />
    
    <!-- For cache directory -->
    <cache-path
        name="cache"
        path="." />
</paths>